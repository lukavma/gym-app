# Copy to .env.local for local development.
# Local dev DB is the docker-compose Postgres 16 service (`docker compose up db`).

# Postgres connection string.
# Local:      postgres://gymapp:gymapp@localhost:5432/gymapp
# Production: Azure Database for PostgreSQL Flexible Server, sslmode=require
#             (set as an App Service App Setting, never committed here)
DATABASE_URL=postgres://gymapp:gymapp@localhost:5432/gymapp

# >=32 random bytes, e.g. `openssl rand -base64 32`.
# Rotating this value logs out every session (ADR-004).
SESSION_SECRET=replace-with-a-real-32-byte-random-secret-before-use

# Application Insights connection string. Leave unset for local dev and tests —
# telemetry is inert (no-op) when this is absent (ADR-009).
APPLICATIONINSIGHTS_CONNECTION_STRING=
